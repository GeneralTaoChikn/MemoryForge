# Copy to .env to override docker-compose defaults:  cp .env.example .env
#
# Where the backend (running in Docker) reaches Ollama.
# Inside a container, "localhost" is the CONTAINER, not your machine — so use
# host.docker.internal to reach Ollama running on the host/WSL.
OLLAMA_URL=http://host.docker.internal:11434

# Model name as shown by `ollama list` (include the tag).
OLLAMA_MODEL=llama3.1:latest

# How long to wait for a generation before timing out.
OLLAMA_TIMEOUT_SECONDS=120
